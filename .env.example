# ---------------------------------------------------------------------------
# SimpleForms — environment variables (Blueprint §15)
# Copy to .env and fill in. Values starting with "mock_" are treated as
# "not configured": the related feature degrades gracefully (see lib/env.ts).
# ---------------------------------------------------------------------------

# Postgres connection string (Neon). Use the pooled URL for the app.
# e.g. postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/simpleforms?sslmode=require
DATABASE_URL=

# NextAuth v5 secret. Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (console.cloud.google.com → Credentials).
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public base URL, no trailing slash. Used for share links, QR codes, emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenRouter (openrouter.ai/keys). Model is swappable without code changes.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Neon Object Storage (bucket defined in neon.ts). `neon deploy` writes these
# to .env.local automatically; for CI/prod create them with:
#   neon credentials create --scope storage:read --scope storage:write
# (AWS_ACCESS_KEY_ID = token_id, AWS_SECRET_ACCESS_KEY = s3_secret_access_key)
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Resend (resend.com/api-keys). EMAIL_FROM must be on a verified domain.
RESEND_API_KEY=
EMAIL_FROM="SimpleForms <hello@yourdomain.co.ke>"

# Bearer token Vercel Cron sends to /api/cron/*. Any long random string.
CRON_SECRET=

# Salt for hashing submitter IPs (rate limiting only; raw IPs never stored).
IP_HASH_SALT=
